@model List<BlogPlatform.Models.Post>

@{
    ViewData["Title"] = "Thẻ";

    var tag = ViewBag.Tag as BlogPlatform.Models.Tag;
}

<div class="container py-4">

    <!-- TIÊU ĐỀ -->

    <div class="mb-4">

        <a asp-area="User"
           asp-controller="Blog"
           asp-action="Index"
           class="text-decoration-none">

            ← Trang chủ

        </a>

        <h2 class="fw-bold mt-3">

            Thẻ:
            #@(tag?.Name ?? "Không xác định")

        </h2>

    </div>


    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Chưa có bài viết nào sử dụng thẻ này.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var post in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <!-- ẢNH -->

                        @if (!string.IsNullOrWhiteSpace(
                            post.FeaturedImageUrl))
                        {
                            <img src="@post.FeaturedImageUrl"
                                 alt="@post.Title"
                                 class="card-img-top"
                                 style="
                                    height:200px;
                                    object-fit:cover;
                                 " />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light"
                                 style="height:200px;">

                                <span class="text-muted">
                                    Không có ảnh
                                </span>

                            </div>
                        }


                        <!-- NỘI DUNG -->

                        <div class="card-body d-flex flex-column">

                            <h4 class="card-title">

                                <a asp-area="User"
                                   asp-controller="Blog"
                                   asp-action="Detail"
                                   asp-route-slug="@post.Slug"
                                   class="text-decoration-none text-dark">

                                    @post.Title

                                </a>

                            </h4>


                            @if (!string.IsNullOrWhiteSpace(post.Summary))
                            {
                                <p class="card-text text-muted">

                                    @post.Summary

                                </p>
                            }


                            @if (post.Author != null)
                            {
                                <div class="mt-auto pt-3">

                                    <small class="text-muted">

                                        Tác giả:

                                        <a asp-area="User"
                                           asp-controller="Blog"
                                           asp-action="Author"
                                           asp-route-username="@post.Author.UserName"
                                           class="text-decoration-none">

                                            @post.Author.DisplayName

                                        </a>

                                    </small>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>