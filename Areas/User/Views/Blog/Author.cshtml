@model List<BlogPlatform.Models.Post>

@{
    ViewData["Title"] = "Trang tác giả";

    var author = ViewBag.Author as BlogPlatform.Models.User;
}

<div class="container py-4">

    <!-- ============================= -->
    <!-- THÔNG TIN TÁC GIẢ -->
    <!-- ============================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h2 class="fw-bold mb-2">
                @(author?.DisplayName ?? author?.UserName)
            </h2>

            <div class="text-muted mb-2">
                @@@(author?.UserName)
            </div>

            @if (!string.IsNullOrWhiteSpace(author?.Bio))
            {
                <p class="mb-0">
                    @author.Bio
                </p>
            }

        </div>

    </div>


    <!-- ============================= -->
    <!-- BÀI VIẾT -->
    <!-- ============================= -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h3 class="fw-bold mb-0">
            Bài viết đã đăng
        </h3>

        <span class="text-muted">
            @Model.Count bài viết
        </span>

    </div>


    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Tác giả chưa có bài viết nào được đăng.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var post in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <!-- ẢNH -->

                        @if (!string.IsNullOrWhiteSpace(
                            post.FeaturedImageUrl))
                        {
                            <img src="@post.FeaturedImageUrl"
                                 alt="@post.Title"
                                 class="card-img-top"
                                 style="
                                    height:200px;
                                    object-fit:cover;
                                 " />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light"
                                 style="height:200px;">

                                <span class="text-muted">
                                    Không có ảnh
                                </span>

                            </div>
                        }


                        <!-- NỘI DUNG -->

                        <div class="card-body d-flex flex-column">

                            @if (post.Category != null)
                            {
                                <span class="badge bg-primary align-self-start mb-2">
                                    @post.Category.Name
                                </span>
                            }


                            <h4 class="card-title">

                                <a asp-area="User"
                                   asp-controller="Blog"
                                   asp-action="Detail"
                                   asp-route-slug="@post.Slug"
                                   class="text-decoration-none text-dark">

                                    @post.Title

                                </a>

                            </h4>


                            @if (!string.IsNullOrWhiteSpace(post.Summary))
                            {
                                <p class="card-text text-muted">

                                    @post.Summary

                                </p>
                            }


                            <div class="mt-auto pt-3">

                                @if (post.PublishedAt.HasValue)
                                {
                                    <small class="text-muted">

                                        @post.PublishedAt.Value.ToString(
                                            "dd/MM/yyyy HH:mm")

                                    </small>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>