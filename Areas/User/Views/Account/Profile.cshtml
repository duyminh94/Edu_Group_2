@model BlogPlatform.Models.User

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h4 class="card-title fw-bold mb-0"><i class="bi bi-person-gear me-2"></i>Hồ sơ cá nhân</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                            <i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-area="User" asp-controller="Account" asp-action="Profile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="text-center mb-4">
                            <div class="position-relative d-inline-block mb-2">
                                <img id="avatarPreview" src="@(!string.IsNullOrEmpty(Model.AvatarUrl) ? Model.AvatarUrl : "")" 
                                     alt="Avatar" class="rounded-circle shadow-sm @(string.IsNullOrEmpty(Model.AvatarUrl) ? "d-none" : "")" 
                                     style="width: 110px; height: 110px; object-fit: cover; border: 3px solid var(--primary-light, #eef2ff);" />
                                
                                <div id="avatarFallback" class="rounded-circle mx-auto bg-light text-primary d-flex align-items-center justify-content-center fw-bold fs-1 @(!string.IsNullOrEmpty(Model.AvatarUrl) ? "d-none" : "")" 
                                     style="width: 110px; height: 110px; border: 3px solid var(--primary-light, #eef2ff); color: #4f46e5;">
                                    @(Model.DisplayName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                </div>
                            </div>
                            <h5 class="fw-bold mb-0">@Model.DisplayName</h5>
                            <span class="badge bg-secondary mt-1">@Model.Role?.Name</span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Tên đăng nhập (Username)</label>
                            <input type="text" class="form-control bg-light" value="@Model.UserName" disabled />
                            <div class="form-text">Tên đăng nhập không thể thay đổi.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Email</label>
                            <input type="email" class="form-control bg-light" value="@Model.Email" disabled />
                        </div>

                        <div class="mb-3">
                            <label for="displayName" class="form-label fw-bold">Tên hiển thị <span class="text-danger">*</span></label>
                            <input type="text" id="displayName" name="displayName" class="form-control" value="@Model.DisplayName" required />
                        </div>

                        <div class="card bg-light border-0 p-3 mb-3 rounded-3">
                            <label class="form-label fw-bold mb-2"><i class="fa-solid fa-camera me-1"></i>Ảnh đại diện (Avatar)</label>
                            
                            <div class="mb-2">
                                <label for="avatarFile" class="form-label small text-muted">Tải ảnh lên từ máy tính (JPG, PNG, WEBP, max 5MB):</label>
                                <input type="file" id="avatarFile" name="avatarFile" class="form-control" accept="image/*" />
                            </div>

                            <div class="text-center text-muted small my-1">— Hoặc nhập URL ảnh có sẵn —</div>

                            <div>
                                <label for="avatarUrl" class="form-label small text-muted">Đường dẫn ảnh đại diện (Avatar URL):</label>
                                <input type="url" id="avatarUrl" name="avatarUrl" class="form-control" value="@Model.AvatarUrl" placeholder="https://example.com/avatar.jpg" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="bio" class="form-label fw-bold">Tiểu sử (Bio)</label>
                            <textarea id="bio" name="bio" class="form-control" rows="4" placeholder="Giới thiệu bản thân...">@Model.Bio</textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-area="User" asp-controller="Blog" asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Lưu thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const avatarFile = document.getElementById('avatarFile');
            const avatarUrl = document.getElementById('avatarUrl');
            const avatarPreview = document.getElementById('avatarPreview');
            const avatarFallback = document.getElementById('avatarFallback');

            function updatePreview(src) {
                if (src) {
                    avatarPreview.src = src;
                    avatarPreview.classList.remove('d-none');
                    if (avatarFallback) avatarFallback.classList.add('d-none');
                }
            }

            if (avatarFile) {
                avatarFile.addEventListener('change', function (e) {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (event) {
                            updatePreview(event.target.result);
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }

            if (avatarUrl) {
                avatarUrl.addEventListener('input', function (e) {
                    const url = e.target.value.trim();
                    if (url && (!avatarFile.files || avatarFile.files.length === 0)) {
                        updatePreview(url);
                    }
                });
            }
        });
    </script>
}
