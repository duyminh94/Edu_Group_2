@model List<PostListItemViewModel>
@{
    ViewData["Title"] = "Bài đã lưu";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 font-weight-bold mb-1">
                <i class="bi bi-bookmark-fill text-primary me-2"></i>Bài viết đã lưu
            </h1>
            <p class="text-muted mb-0">Danh sách các bài viết bạn đã lưu lại để đọc sau.</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
                <i class="bi bi-journal-bookmark me-1"></i>Đã lưu: @Model.Count
            </span>
        </div>
    </div>

    @Html.AntiForgeryToken()

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-bookmark-x text-muted display-4 d-block mb-3"></i>
                <h4 class="fw-bold text-secondary">Chưa có bài viết nào được lưu</h4>
                <p class="text-muted mb-3">Hãy bấm nút "Lưu bài" ở dưới mỗi bài viết yêu thích để xem lại sau tại đây.</p>
                <a href="/" class="btn btn-primary px-4 fw-semibold">
                    <i class="bi bi-compass me-1"></i>Khám phá bài viết
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var post in Model)
            {
                <div class="col" id="bookmark-card-@post.Id">
                    <div class="card h-100 border-0 shadow-sm hover-shadow transition-all">
                        @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
                        {
                            <img src="@post.FeaturedImageUrl" class="card-img-top" alt="@post.Title" style="height: 180px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light card-img-top d-flex align-items-center justify-content-center text-secondary" style="height: 180px;">
                                <i class="bi bi-card-image fs-1"></i>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            @if (!string.IsNullOrEmpty(post.CategoryName))
                            {
                                <div class="mb-2">
                                    <span class="badge bg-light text-primary border">@post.CategoryName</span>
                                </div>
                            }

                            <h5 class="card-title font-weight-bold mb-2">
                                <a href="/post/@(string.IsNullOrEmpty(post.Slug) ? post.Id.ToString() : post.Slug)" class="text-decoration-none text-dark">
                                    @post.Title
                                </a>
                            </h5>

                            @if (!string.IsNullOrEmpty(post.Summary))
                            {
                                <p class="card-text text-muted small flex-grow-1 text-truncate-3 mb-3">
                                    @post.Summary
                                </p>
                            }

                            <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between text-muted small">
                                <div>
                                    <i class="bi bi-person me-1"></i>@post.AuthorDisplayName
                                </div>
                                <div class="d-flex gap-3">
                                    <span><i class="bi bi-heart me-1"></i>@post.LikeCount</span>
                                    <span><i class="bi bi-chat me-1"></i>@post.CommentCount</span>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex justify-content-end">
                            <button type="button" 
                                    class="btn btn-sm btn-outline-danger" 
                                    title="Bỏ lưu bài viết" 
                                    onclick="removeBookmark(@post.Id)">
                                <i class="bi bi-bookmark-dash me-1"></i>Bỏ lưu
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    function removeBookmark(postId) {
        if (!confirm("Bạn có muốn bỏ lưu bài viết này không?")) return;

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const formData = new FormData();
        formData.append('postId', postId);
        if (token) formData.append('__RequestVerificationToken', token);

        fetch('/User/Interaction/ToggleBookmark', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
            if (data.isSuccess && !data.isActive) {
                const card = document.getElementById(`bookmark-card-${postId}`);
                if (card) {
                    card.style.transition = 'all 0.3s ease';
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.9)';
                    setTimeout(() => {
                        card.remove();
                        const remaining = document.querySelectorAll('.row-cols-1 .col');
                        if (remaining.length === 0) {
                            location.reload();
                        }
                    }, 300);
                }
            }
        })
        .catch(err => {
            alert('Đã xảy ra lỗi khi thực hiện thao tác.');
        });
    }
</script>

