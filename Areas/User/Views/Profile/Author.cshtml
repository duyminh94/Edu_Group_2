@model BlogPlatform.ViewModel.AuthorProfileViewModel

@{
    ViewData["Title"] = $"Tác giả: {Model.Author.DisplayName}";
    var primaryColor = !string.IsNullOrEmpty(Model.Setting?.PrimaryColor) ? Model.Setting.PrimaryColor : "#4f46e5";
    var fontFamily = !string.IsNullOrEmpty(Model.Setting?.FontFamily) ? Model.Setting.FontFamily : "system-ui";
    int totalPages = (int)Math.Ceiling((double)Model.TotalPosts / Model.PageSize);
}

<style>
    .author-header-card {
        border-top: 4px solid @primaryColor;
        font-family: @fontFamily, sans-serif;
    }
    .author-avatar {
        width: 96px;
        height: 96px;
        object-fit: cover;
        border: 3px solid @primaryColor;
    }
    .author-accent-btn {
        background-color: @primaryColor;
        color: #fff;
        border: none;
    }
    .author-accent-btn:hover {
        opacity: 0.9;
        color: #fff;
    }
    .author-badge {
        background-color: @primaryColor;
        color: #fff;
    }
</style>

<div class="container my-4">
    <!-- Author Header Profile Banner -->
    <div class="card shadow-sm mb-4 author-header-card">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row align-items-center gap-4">
                @if (!string.IsNullOrEmpty(Model.Setting?.LogoUrl))
                {
                    <img src="@Model.Setting.LogoUrl" alt="Logo" class="rounded author-avatar" />
                }
                else if (!string.IsNullOrEmpty(Model.Author.AvatarUrl))
                {
                    <img src="@Model.Author.AvatarUrl" alt="@Model.Author.DisplayName" class="rounded-circle author-avatar" />
                }
                else
                {
                    <div class="rounded-circle author-avatar d-flex align-items-center justify-content-center bg-light text-secondary fs-2 fw-bold">
                        @Model.Author.DisplayName.FirstOrDefault()
                    </div>
                }

                <div class="flex-grow-1 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <h2 class="mb-0 fw-bold">@Model.Author.DisplayName</h2>
                        <span class="badge author-badge">Tác giả</span>
                    </div>
                    <p class="text-muted mb-2">@@@Model.Author.UserName</p>
                    
                    @if (!string.IsNullOrEmpty(Model.Setting?.Tagline))
                    {
                        <p class="fst-italic text-secondary mb-2"><i class="bi bi-quote me-1"></i>@Model.Setting.Tagline</p>
                    }

                    @if (!string.IsNullOrEmpty(Model.Author.Bio))
                    {
                        <p class="mb-2">@Model.Author.Bio</p>
                    }
                    else
                    {
                        <p class="text-muted small mb-2">Chưa cập nhật tiểu sử.</p>
                    }

                    <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-3 small text-muted">
                        <span><i class="bi bi-file-earmark-post me-1"></i><strong>@Model.TotalPosts</strong> bài viết</span>
                        <span><i class="bi bi-calendar3 me-1"></i>Tham gia từ @Model.Author.CreatedAt.ToString("MM/yyyy")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Author's Posts Section -->
    <h4 class="fw-bold mb-3"><i class="bi bi-journal-text me-2"></i>Bài viết của @Model.Author.DisplayName</h4>

    @if (Model.Posts == null || !Model.Posts.Any())
    {
        <div class="alert alert-info text-center py-4">
            <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
            Tác giả này chưa xuất bản bài viết nào.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var post in Model.Posts)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
                        {
                            <img src="@post.FeaturedImageUrl" class="card-img-top" alt="@post.Title" style="height: 180px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light card-img-top d-flex align-items-center justify-content-center text-muted" style="height: 180px;">
                                <i class="bi bi-image fs-1"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            @if (!string.IsNullOrEmpty(post.CategoryName))
                            {
                                <div class="mb-2">
                                    <a asp-area="User" asp-controller="Blog" asp-action="Category" asp-route-slug="@post.CategorySlug" class="badge text-decoration-none bg-secondary">
                                        @post.CategoryName
                                    </a>
                                </div>
                            }
                            <h5 class="card-title fw-bold text-truncate">
                                <a asp-area="User" asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug" class="text-decoration-none text-dark">
                                    @post.Title
                                </a>
                            </h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(post.Summary?.Length > 120 ? post.Summary.Substring(0, 120) + "..." : post.Summary)
                            </p>
                            <div class="d-flex justify-content-between align-items-center text-muted small pt-2 border-top">
                                <span><i class="bi bi-calendar-event me-1"></i>@(post.PublishedAt?.ToString("dd/MM/yyyy") ?? "")</span>
                                <div>
                                    <span class="me-2"><i class="bi bi-eye me-1"></i>@post.ViewCount</span>
                                    <span class="me-2"><i class="bi bi-hand-thumbs-up me-1"></i>@post.LikeCount</span>
                                    <span><i class="bi bi-chat-dots me-1"></i>@post.CommentCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-item page-link" asp-area="User" asp-controller="Blog" asp-action="Author" asp-route-username="@Model.Author.UserName" asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
