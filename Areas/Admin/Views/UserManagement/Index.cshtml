@model IEnumerable<BlogPlatform.ViewModel.UserListItemViewModel>

@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa-solid fa-users-gear text-primary me-2"></i>Quản lý Người dùng</h2>
            <p class="text-muted mb-0">Quản lý phân quyền vai trò, khóa và mở khóa tài khoản thành viên trong hệ thống</p>
        </div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Bảng điều khiển
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0"><i class="fa-solid fa-user-group me-2"></i>Danh sách người dùng (@(Model?.Count() ?? 0))</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Người dùng</th>
                            <th>Email</th>
                            <th class="text-center">Vai trò hiện tại</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Phân quyền vai trò</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@user.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-light text-primary d-flex align-items-center justify-content-center fw-bold border" style="width: 38px; height: 38px; background-color: var(--primary-light, #eef2ff); color: var(--primary, #4f46e5);">
                                                @(string.IsNullOrEmpty(user.DisplayName) ? user.UserName.FirstOrDefault().ToString().ToUpper() : user.DisplayName.FirstOrDefault().ToString().ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold">@user.DisplayName</div>
                                                <div class="text-muted small">@@@user.UserName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td class="text-center">
                                        @if (user.RoleName == "Admin")
                                        {
                                            <span class="badge bg-danger"><i class="fa-solid fa-user-shield me-1"></i>Admin</span>
                                        }
                                        else if (user.RoleName == "Author")
                                        {
                                            <span class="badge bg-primary"><i class="fa-solid fa-pen-nib me-1"></i>Author</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="fa-solid fa-user me-1"></i>Reader</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (user.IsLocked)
                                        {
                                            <span class="badge bg-danger"><i class="fa-solid fa-lock me-1"></i>Đã khóa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Hoạt động</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form asp-area="Admin" asp-controller="UserManagement" asp-action="ChangeRole" method="post" class="d-inline-flex align-items-center gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <select name="newRoleId" class="form-select form-select-sm" style="width: 110px;">
                                                <option value="1" selected="@(user.RoleId == 1)">Admin</option>
                                                <option value="2" selected="@(user.RoleId == 2)">Author</option>
                                                <option value="3" selected="@(user.RoleId == 3)">Reader</option>
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Lưu vai trò mới">
                                                <i class="fa-solid fa-floppy-disk"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-end">
                                        <form asp-area="Admin" asp-controller="UserManagement" asp-action="ToggleLock" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn thực hiện thao tác khóa/mở tài khoản này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            @if (user.IsLocked)
                                            {
                                                <button type="submit" class="btn btn-sm btn-success" title="Mở khóa tài khoản">
                                                    <i class="fa-solid fa-lock-open me-1"></i>Mở khóa
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Khóa tài khoản">
                                                    <i class="fa-solid fa-user-lock me-1"></i>Khóa
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fa-regular fa-folder-open fs-1 d-block mb-2 opacity-50"></i>
                                    Không có người dùng nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
