@model BlogPlatform.ViewModel.AnalyticsViewModel

@{
    ViewData["Title"] = "Bảng điều khiển Quản trị";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-danger me-2"></i>Bảng điều khiển Quản trị</h2>
            <p class="text-muted mb-0">Tổng quan hệ thống và các công cụ quản lý</p>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-people fs-2"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small">Tổng Người dùng</div>
                        <div class="fs-2 fw-bold">@Model.TotalUsers</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-journal-text fs-2"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small">Tổng Bài viết</div>
                        <div class="fs-2 fw-bold">@Model.TotalPosts</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-info text-white h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-eye fs-2"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small">Tổng Lượt xem</div>
                        <div class="fs-2 fw-bold">@Model.TotalViews</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-black bg-opacity-10 p-3 me-3">
                        <i class="bi bi-chat-left-text fs-2"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Tổng Bình luận</div>
                        <div class="fs-2 fw-bold">@Model.TotalComments</div>
                        @if (Model.PendingComments > 0)
                        {
                            <span class="badge bg-danger text-white mt-1">@Model.PendingComments cần duyệt</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Actions -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index" class="card shadow-sm border-0 text-decoration-none text-dark h-100 card-hover">
                <div class="card-body p-4 d-flex align-items-center">
                    <i class="bi bi-people-fill fs-1 text-primary me-3"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Quản lý Người dùng</h5>
                        <p class="text-muted small mb-0">Khóa/Mở tài khoản, phân quyền Admin/Author/Reader</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-area="Admin" asp-controller="Taxonomy" asp-action="Index" class="card shadow-sm border-0 text-decoration-none text-dark h-100 card-hover">
                <div class="card-body p-4 d-flex align-items-center">
                    <i class="bi bi-tags-fill fs-1 text-success me-3"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Quản lý Phân loại</h5>
                        <p class="text-muted small mb-0">Thêm, sửa, xóa các Chuyên mục và Thẻ bài viết</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-area="Admin" asp-controller="Moderation" asp-action="Posts" class="card shadow-sm border-0 text-decoration-none text-dark h-100 card-hover">
                <div class="card-body p-4 d-flex align-items-center">
                    <i class="bi bi-shield-x fs-1 text-danger me-3"></i>
                    <div>
                        <h5 class="fw-bold mb-1">Kiểm duyệt Nội dung</h5>
                        <p class="text-muted small mb-0">Gỡ bài viết và bình luận vi phạm trên toàn hệ thống</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Top Posts Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-fire text-danger me-2"></i>Top bài viết nổi bật toàn hệ thống</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.PostRows == null || !Model.PostRows.Any())
            {
                <div class="p-4 text-center text-muted">Chưa có dữ liệu bài viết.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Bài viết</th>
                                <th class="text-center">Ngày xuất bản</th>
                                <th class="text-center">Lượt xem</th>
                                <th class="text-center">Lượt thích</th>
                                <th class="text-center">Bình luận</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var post in Model.PostRows)
                            {
                                <tr>
                                    <td>
                                        <a asp-area="User" asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug" class="fw-bold text-decoration-none text-dark">
                                            @post.Title
                                        </a>
                                    </td>
                                    <td class="text-center text-muted small">@(post.PublishedAt?.ToString("dd/MM/yyyy") ?? "")</td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@post.ViewCount</span></td>
                                    <td class="text-center"><span class="badge bg-light text-danger border">@post.LikeCount</span></td>
                                    <td class="text-center"><span class="badge bg-light text-primary border">@post.CommentCount</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
