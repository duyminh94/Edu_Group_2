@model IEnumerable<BlogPlatform.Models.Post>

@{
    ViewData["Title"] = "Kiểm duyệt Bài viết";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-shield-x text-danger me-2"></i>Kiểm duyệt Nội dung</h2>
            <p class="text-muted mb-0">Quản lý và gỡ bỏ các bài viết/bình luận vi phạm tiêu chuẩn</p>
        </div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Bảng điều khiển
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link active fw-bold" asp-area="Admin" asp-controller="Moderation" asp-action="Posts">
                <i class="bi bi-journal-x me-1"></i>Bài viết (@(Model?.Count() ?? 0))
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Admin" asp-controller="Moderation" asp-action="Comments">
                <i class="bi bi-chat-left-x me-1"></i>Bình luận
            </a>
        </li>
    </ul>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tiêu đề bài viết</th>
                            <th>Tác giả</th>
                            <th>Chuyên mục</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Ngày tạo</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var post in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@post.Title</div>
                                        <code class="small text-muted">@post.Slug</code>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@@@post.Author?.UserName</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@(post.Category?.Name ?? "Chưa phân loại")</span>
                                    </td>
                                    <td class="text-center">
                                        @if (post.Status == BlogPlatform.Models.Enums.PostStatus.Published)
                                        {
                                            <span class="badge bg-success">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Draft</span>
                                        }
                                    </td>
                                    <td class="text-center text-muted small">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-1">
                                            <a asp-area="User" asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug" target="_blank" class="btn btn-sm btn-outline-info" title="Xem bài viết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <form asp-area="Admin" asp-controller="Moderation" asp-action="DeletePost" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn gỡ bài viết vi phạm này? Action này không thể hoàn tác.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@post.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Gỡ bài viết">
                                                    <i class="bi bi-trash me-1"></i>Gỡ bài
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Không có bài viết nào trong hệ thống.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
