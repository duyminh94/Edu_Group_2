@{
    ViewData["Title"] = "Quản lý Chuyên mục & Thẻ";
    var categories = ViewBag.Categories as IEnumerable<BlogPlatform.Models.Category> ?? new List<BlogPlatform.Models.Category>();
    var tags = ViewBag.Tags as IEnumerable<BlogPlatform.Models.Tag> ?? new List<BlogPlatform.Models.Tag>();
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-tags-fill text-success me-2"></i>Quản lý Chuyên mục & Thẻ</h2>
            <p class="text-muted mb-0">Tạo mới, chỉnh sửa và quản lý danh mục phân loại bài viết</p>
        </div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Bảng điều khiển
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Categories Section -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-folder-fill text-warning me-2"></i>Chuyên mục (Categories)</h5>
                </div>
                <div class="card-body p-3">
                    <!-- Create Category Form -->
                    <form asp-area="Admin" asp-controller="Taxonomy" asp-action="CreateCategory" method="post" class="mb-4 p-3 bg-light rounded border">
                        @Html.AntiForgeryToken()
                        <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i>Thêm chuyên mục mới</h6>
                        <div class="row g-2">
                            <div class="col-md-5">
                                <input type="text" name="name" class="form-control form-control-sm" placeholder="Tên chuyên mục..." required />
                            </div>
                            <div class="col-md-5">
                                <input type="text" name="description" class="form-control form-control-sm" placeholder="Mô tả ngắn..." />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-sm btn-primary w-100">Thêm</button>
                            </div>
                        </div>
                    </form>

                    <!-- Categories List Table -->
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên chuyên mục</th>
                                    <th>Slug</th>
                                    <th>Mô tả</th>
                                    <th class="text-end">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (categories.Any())
                                {
                                    @foreach (var cat in categories)
                                    {
                                        <tr>
                                            <td class="fw-bold">@cat.Name</td>
                                            <td><code class="small text-muted">@cat.Slug</code></td>
                                            <td class="text-muted small">@cat.Description</td>
                                            <td class="text-end">
                                                <form asp-area="Admin" asp-controller="Taxonomy" asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa chuyên mục này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@cat.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">Chưa có chuyên mục nào.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tags Section -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-tag-fill text-info me-2"></i>Thẻ bài viết (Tags)</h5>
                </div>
                <div class="card-body p-3">
                    <!-- Create Tag Form -->
                    <form asp-area="Admin" asp-controller="Taxonomy" asp-action="CreateTag" method="post" class="mb-4 p-3 bg-light rounded border">
                        @Html.AntiForgeryToken()
                        <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i>Thêm thẻ mới</h6>
                        <div class="input-group input-group-sm">
                            <input type="text" name="name" class="form-control" placeholder="Tên thẻ (ví dụ: csharp, dotnet)..." required />
                            <button type="submit" class="btn btn-success">Thêm Thẻ</button>
                        </div>
                    </form>

                    <!-- Tags List -->
                    @if (tags.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tag in tags)
                            {
                                <div class="badge bg-light text-dark border p-2 d-flex align-items-center gap-2">
                                    <span>#@tag.Name</span>
                                    <form asp-area="Admin" asp-controller="Taxonomy" asp-action="DeleteTag" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa thẻ này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@tag.Id" />
                                        <button type="submit" class="btn-close btn-close-sm" style="font-size: 0.65rem;" title="Xóa thẻ"></button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted py-3 mb-0">Chưa có thẻ nào.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
