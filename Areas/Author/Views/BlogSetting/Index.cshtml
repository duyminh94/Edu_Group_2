@model BlogPlatform.ViewModel.BlogSettingViewModel
@{
    ViewData["Title"] = "Tùy biến giao diện Blog";
}

<div class="container my-4">
    <h2>Tùy biến giao diện Blog</h2>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row mt-4">
        <div class="col-md-6">
            <form asp-area="Author" asp-controller="BlogSetting" asp-action="Index" method="post">
                <div class="mb-3">
                    <label asp-for="ThemeName" class="form-label font-weight-bold"></label>
                    <select asp-for="ThemeName" class="form-select form-control" id="themeSelect">
                        @foreach (var theme in Model.AvailableThemes)
                        {
                            <option value="@theme">@theme</option>
                        }
                    </select>
                    <span asp-validation-for="ThemeName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PrimaryColor" class="form-label font-weight-bold"></label>
                    <input type="color" asp-for="PrimaryColor" class="form-control form-control-color" id="primaryColorInput" />
                    <span asp-validation-for="PrimaryColor" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FontFamily" class="form-label font-weight-bold"></label>
                    <select asp-for="FontFamily" class="form-select form-control" id="fontSelect">
                        @foreach (var font in Model.AvailableFonts)
                        {
                            <option value="@font">@font</option>
                        }
                    </select>
                    <span asp-validation-for="FontFamily" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tagline" class="form-label font-weight-bold"></label>
                    <input type="text" asp-for="Tagline" class="form-control" id="taglineInput" placeholder="Nhập slogan của bạn..." />
                    <span asp-validation-for="Tagline" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LogoUrl" class="form-label font-weight-bold"></label>
                    <input type="text" asp-for="LogoUrl" class="form-control" placeholder="https://example.com/logo.png" />
                    <span asp-validation-for="LogoUrl" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Lưu giao diện</button>
            </form>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header font-weight-bold">Xem trước giao diện (Live Preview)</div>
                <div class="card-body">
                    <div id="previewBox" class="p-4 border rounded" style="transition: all 0.3s ease;">
                        <h4 id="previewTagline" class="mb-3">@Model.Tagline</h4>
                        <p id="previewText">Đoạn văn bản xem trước phông chữ và màu chủ đạo.</p>
                        <button id="previewBtn" class="btn text-white">Nút bấm mẫu</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updatePreview() {
            const color = document.getElementById('primaryColorInput').value;
            const font = document.getElementById('fontSelect').value;
            const tagline = document.getElementById('taglineInput').value;

            const previewBox = document.getElementById('previewBox');
            const previewBtn = document.getElementById('previewBtn');
            const previewTagline = document.getElementById('previewTagline');

            previewBox.style.fontFamily = font;
            previewBtn.style.backgroundColor = color;
            previewBtn.style.borderColor = color;
            previewTagline.innerText = tagline || "Slogan blog...";
            previewTagline.style.color = color;
        }

        document.getElementById('primaryColorInput').addEventListener('input', updatePreview);
        document.getElementById('fontSelect').addEventListener('change', updatePreview);
        document.getElementById('taglineInput').addEventListener('input', updatePreview);

        updatePreview();
    </script>
}
