@model List<CommentListItemViewModel>
@{
    ViewData["Title"] = "Kiểm duyệt bình luận";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 font-weight-bold mb-1">
                <i class="bi bi-shield-check text-primary me-2"></i>Kiểm duyệt bình luận
            </h1>
            <p class="text-muted mb-0">Quản lý và duyệt các bình luận chờ xử lý trên bài viết của bạn.</p>
        </div>
        <div>
            <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">
                <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt: @Model.Count
            </span>
        </div>
    </div>

    @* Alert box *@
    <div id="moderation-alert" class="alert d-none alert-dismissible fade show mb-4" role="alert">
        <span id="moderation-alert-msg"></span>
        <button type="button" class="btn-close" onclick="this.parentElement.classList.add('d-none')"></button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @Html.AntiForgeryToken()

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-chat-square-check text-success display-4 d-block mb-3"></i>
                <h4 class="fw-bold text-secondary">Không có bình luận nào chờ duyệt</h4>
                <p class="text-muted">Tất cả bình luận gửi đến bài viết của bạn đã được kiểm duyệt hoặc xử lý.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 20%;">Người bình luận</th>
                            <th scope="col" style="width: 35%;">Nội dung bình luận</th>
                            <th scope="col" style="width: 25%;">Bài viết gốc</th>
                            <th scope="col" style="width: 20%;" class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr id="comment-row-@item.Id">
                                <td>
                                    <div class="fw-bold text-dark mb-1">@item.UserDisplayName</div>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ParentExcerpt))
                                    {
                                        <div class="p-2 bg-light rounded border-start border-3 border-info mb-2 small text-muted">
                                            <i class="bi bi-reply-fill me-1"></i><strong>Trả lời:</strong> "@item.ParentExcerpt"
                                        </div>
                                    }
                                    <div class="text-break text-secondary">
                                        @Html.Raw(item.Content)
                                    </div>
                                </td>
                                <td>
                                    <a href="/post/@(string.IsNullOrEmpty(item.PostSlug) ? item.PostId.ToString() : item.PostSlug)" 
                                       target="_blank" 
                                       class="text-decoration-none fw-semibold text-primary">
                                        <i class="bi bi-journal-text me-1"></i>@item.PostTitle
                                    </a>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" 
                                                class="btn btn-success" 
                                                title="Duyệt bình luận"
                                                onclick="moderateComment(@item.Id, 'Approve')">
                                            <i class="bi bi-check-lg me-1"></i>Duyệt
                                        </button>
                                        <button type="button" 
                                                class="btn btn-outline-secondary" 
                                                title="Từ chối"
                                                onclick="moderateComment(@item.Id, 'Reject')">
                                            <i class="bi bi-x-lg me-1"></i>Từ chối
                                        </button>
                                        <button type="button" 
                                                class="btn btn-outline-warning text-dark" 
                                                title="Gắn cờ vi phạm"
                                                onclick="moderateComment(@item.Id, 'Flag')">
                                            <i class="bi bi-flag me-1"></i>Gắn cờ
                                        </button>
                                        <button type="button" 
                                                class="btn btn-outline-danger" 
                                                title="Xóa bình luận"
                                                onclick="moderateComment(@item.Id, 'Delete')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<script>
    function moderateComment(commentId, action) {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        if (action === 'Delete' && !confirm('Bạn có chắc chắn muốn xóa vĩnh viễn bình luận này?')) {
            return;
        }

        const formData = new FormData();
        formData.append('id', commentId);
        if (token) {
            formData.append('__RequestVerificationToken', token);
        }

        fetch(`/Author/CommentModeration/${action}`, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(res => res.json())
        .then(data => {
            const alertBox = document.getElementById('moderation-alert');
            const alertMsg = document.getElementById('moderation-alert-msg');

            if (alertBox && alertMsg) {
                alertBox.className = 'alert alert-dismissible fade show ' + (data.success ? 'alert-success' : 'alert-danger');
                alertMsg.textContent = data.message;
                alertBox.classList.remove('d-none');
            }

            if (data.success) {
                const row = document.getElementById(`comment-row-${commentId}`);
                if (row) {
                    row.style.transition = 'all 0.3s ease';
                    row.style.opacity = '0';
                    setTimeout(() => {
                        row.remove();
                        const remainingRows = document.querySelectorAll('tbody tr');
                        if (remainingRows.length === 0) {
                            location.reload();
                        }
                    }, 300);
                }
            }
        })
        .catch(err => {
            alert('Đã xảy ra lỗi khi kết nối máy chủ.');
        });
    }
</script>

