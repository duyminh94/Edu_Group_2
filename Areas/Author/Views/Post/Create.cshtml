@model BlogPlatform.ViewModel.PostEditViewModel

@{
    ViewData["Title"] = "Viết bài mới";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Viết bài mới</h2>
    </div>

    <form asp-area="Author"
          asp-controller="Post"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>

            <input asp-for="Title"
                   class="form-control"
                   placeholder="Nhập tiêu đề bài viết..." />

            <span asp-validation-for="Title"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Summary" class="form-label"></label>

            <textarea asp-for="Summary"
                      class="form-control"
                      rows="3"
                      placeholder="Nhập tóm tắt bài viết..."></textarea>

            <span asp-validation-for="Summary"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label"></label>

            <textarea asp-for="Content"
                      class="form-control"
                      rows="12"
                      placeholder="Nhập nội dung bài viết..."></textarea>

            <span asp-validation-for="Content"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="FeaturedImageUrl"
                   class="form-label"></label>

            <input asp-for="FeaturedImageUrl"
                   class="form-control"
                   placeholder="https://..." />

            <span asp-validation-for="FeaturedImageUrl"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId"
                   class="form-label"></label>

            <select asp-for="CategoryId"
                    asp-items="Model.Categories"
                    class="form-select">

                <option value="">-- Chọn chuyên mục --</option>

            </select>
        </div>

        <div class="mb-3">
            <label asp-for="TagNames"
                   class="form-label"></label>

            <input asp-for="TagNames"
                   class="form-control"
                   placeholder="aspnet, csharp, ef-core" />

            <div class="form-text">
                Nhập các thẻ, cách nhau bằng dấu phẩy.
            </div>
        </div>

        <div class="mb-3">
            <strong>Trạng thái:</strong>
            <span class="badge bg-secondary">
                Bản nháp
            </span>
        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">
                Tạo bài viết
            </button>

            <a asp-area="Author"
               asp-controller="Post"
               asp-action="Index"
               class="btn btn-secondary">
                Hủy
            </a>

        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}