@model BlogPlatform.ViewModel.PostEditViewModel

@{
    ViewData["Title"] = "Sửa bài viết";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Sửa bài viết</h2>
            <p class="text-muted mb-0">
                Chỉnh sửa nội dung bài viết
            </p>
        </div>

        <a asp-area="Author"
           asp-controller="Post"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Quay lại
        </a>

    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-area="Author"
                  asp-controller="Post"
                  asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <!-- TIÊU ĐỀ -->
                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>

                <!-- TÓM TẮT -->
                <div class="mb-3">

                    <label asp-for="Summary"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="Summary"
                              class="form-control"
                              rows="3">
                    </textarea>

                    <span asp-validation-for="Summary"
                          class="text-danger">
                    </span>

                </div>

                <!-- NỘI DUNG -->
                <div class="mb-3">

                    <label asp-for="Content"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="Content"
                              class="form-control"
                              rows="12">
                    </textarea>

                    <span asp-validation-for="Content"
                          class="text-danger">
                    </span>

                </div>

                <!-- CATEGORY -->
                <div class="mb-3">

                    <label asp-for="CategoryId"
                           class="form-label fw-semibold">
                    </label>

                    <select asp-for="CategoryId"
                            asp-items="Model.Categories"
                            class="form-select">

                        <option value="">
                            -- Chọn chuyên mục --
                        </option>

                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger">
                    </span>

                </div>

                <!-- TAG -->
                <div class="mb-3">

                    <label asp-for="TagNames"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="TagNames"
                           class="form-control" />

                    <div class="form-text">
                        Nhập nhiều thẻ, ngăn cách bằng dấu phẩy.
                    </div>

                </div>

                <!-- ẢNH HIỆN TẠI -->
                @if (!string.IsNullOrWhiteSpace(Model.FeaturedImageUrl))
                {
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Ảnh hiện tại
                        </label>

                        <div>
                            <img src="@Model.FeaturedImageUrl"
                                 alt="Ảnh bài viết"
                                 style="max-width:300px; max-height:200px; object-fit:cover;"
                                 class="img-thumbnail" />
                        </div>

                    </div>
                }

                <!-- ẢNH MỚI -->
                <div class="mb-4">

                    <label asp-for="ImageFile"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                    <div class="form-text">
                        Nếu không chọn ảnh mới thì ảnh cũ được giữ lại.
                    </div>

                    <span asp-validation-for="ImageFile"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Lưu thay đổi
                    </button>

                    <a asp-area="Author"
                       asp-controller="Post"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Hủy
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}