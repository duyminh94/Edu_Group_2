@model BlogPlatform.ViewModel.PostEditViewModel

@{
    ViewData["Title"] = "Sửa bài viết";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Sửa bài viết</h2>

        @if (!string.IsNullOrWhiteSpace(Model.Slug))
        {
            <div class="text-muted">
                Slug hiện tại:
                <strong>/post/@Model.Slug</strong>
            </div>
        }
    </div>

    <form asp-area="Author"
          asp-controller="Post"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="Title"
                   class="form-label"></label>

            <input asp-for="Title"
                   class="form-control" />

            <span asp-validation-for="Title"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Summary"
                   class="form-label"></label>

            <textarea asp-for="Summary"
                      class="form-control"
                      rows="3"></textarea>

            <span asp-validation-for="Summary"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Content"
                   class="form-label"></label>

            <textarea asp-for="Content"
                      class="form-control"
                      rows="12"></textarea>

            <span asp-validation-for="Content"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="FeaturedImageUrl"
                   class="form-label"></label>

            <input asp-for="FeaturedImageUrl"
                   class="form-control" />

            <span asp-validation-for="FeaturedImageUrl"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId"
                   class="form-label"></label>

            <select asp-for="CategoryId"
                    asp-items="Model.Categories"
                    class="form-select">

                <option value="">-- Chọn chuyên mục --</option>

            </select>
        </div>

        <div class="mb-3">
            <label asp-for="TagNames"
                   class="form-label"></label>

            <input asp-for="TagNames"
                   class="form-control" />

            <div class="form-text">
                Ví dụ: aspnet, csharp, ef-core
            </div>
        </div>

        <div class="mb-3">
            <strong>Trạng thái:</strong>

            @switch (Model.Status)
            {
                case BlogPlatform.Models.Enums.PostStatus.Draft:
                    <span class="badge bg-secondary">
                        Bản nháp
                    </span>
                    break;

                case BlogPlatform.Models.Enums.PostStatus.Published:
                    <span class="badge bg-success">
                        Đã đăng
                    </span>
                    break;

                case BlogPlatform.Models.Enums.PostStatus.Unpublished:
                    <span class="badge bg-warning text-dark">
                        Đã gỡ
                    </span>
                    break;
            }
        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">
                Lưu thay đổi
            </button>

            <a asp-area="Author"
               asp-controller="Post"
               asp-action="Index"
               class="btn btn-secondary">
                Hủy
            </a>

        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}