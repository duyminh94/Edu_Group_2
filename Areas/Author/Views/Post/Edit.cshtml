@model BlogPlatform.ViewModel.PostEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Sửa bài viết</h2>
            @if (!string.IsNullOrWhiteSpace(Model.Slug))
            {
                <p class="text-muted mb-0 small">
                    Đường dẫn bài viết: <a href="/post/@Model.Slug" target="_blank" class="fw-bold text-decoration-none">/post/@Model.Slug <i class="fa-solid fa-arrow-up-right-from-square ms-1 small"></i></a>
                </p>
            }
        </div>
        <a asp-area="Author" asp-controller="Post" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <form asp-area="Author" asp-controller="Post" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

        <div class="row g-4">
            <!-- Cột trái: Tiêu đề & Nội dung -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="Nhập tiêu đề..." required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label fw-bold">Tóm tắt ngắn (Summary)</label>
                        <textarea asp-for="Summary" class="form-control" rows="3" placeholder="Tóm tắt ngắn..."></textarea>
                        <span asp-validation-for="Summary" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Content" class="form-label fw-bold">Nội dung chi tiết <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" class="form-control" rows="15" placeholder="Soạn thảo nội dung..." required></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Phân loại & Cấu hình -->
            <div class="col-lg-4">
                <!-- Card Trạng thái & Lưu -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-floppy-disk me-2 text-primary"></i>Lưu thay đổi</h5>
                    <div class="mb-3">
                        <span class="text-muted small fw-bold d-block mb-1">Trạng thái hiện tại:</span>
                        @switch (Model.Status)
                        {
                            case BlogPlatform.Models.Enums.PostStatus.Draft:
                                <span class="badge bg-secondary fs-6"><i class="fa-solid fa-pen-ruler me-1"></i>Bản nháp</span>
                                break;
                            case BlogPlatform.Models.Enums.PostStatus.Published:
                                <span class="badge bg-success fs-6"><i class="fa-solid fa-check me-1"></i>Đã xuất bản</span>
                                break;
                            case BlogPlatform.Models.Enums.PostStatus.Unpublished:
                                <span class="badge bg-warning text-dark fs-6"><i class="fa-solid fa-eye-slash me-1"></i>Đã gỡ bài</span>
                                break;
                        }
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary fw-bold py-2">
                            <i class="fa-solid fa-save me-1"></i>Lưu thay đổi
                        </button>
                        <a asp-area="Author" asp-controller="Post" asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    </div>
                </div>

                <!-- Card Chuyên mục & Thẻ -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-folder-open me-2 text-primary"></i>Phân loại</h5>
                    
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-bold">Chuyên mục</label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                            <option value="">-- Chọn chuyên mục --</option>
                        </select>
                    </div>

                    <div class="mb-0">
                        <label asp-for="TagNames" class="form-label fw-bold">Thẻ bài viết (Tags)</label>
                        <input asp-for="TagNames" class="form-control" placeholder="aspnet, csharp, efcore" />
                        <div class="form-text">Nhập các thẻ bài viết, phân tách bằng dấu phẩy.</div>
                    </div>
                </div>

                <!-- Card Ảnh đại diện bài viết -->
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-3"><i class="fa-solid fa-image me-2 text-primary"></i>Ảnh bìa (Featured Image)</h5>
                    <div class="mb-3">
                        <label asp-for="FeaturedImageUrl" class="form-label small text-muted">Đường dẫn URL ảnh bìa:</label>
                        <input asp-for="FeaturedImageUrl" id="imgUrlInput" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="FeaturedImageUrl" class="text-danger small"></span>
                    </div>
                    <div class="text-center bg-light p-2 rounded-3 border">
                        <img id="imgPreview" src="@Model.FeaturedImageUrl" alt="Preview" class="img-fluid rounded @(string.IsNullOrEmpty(Model.FeaturedImageUrl) ? "d-none" : "")" style="max-height: 180px; object-fit: cover;" />
                        <div id="imgPlaceholder" class="text-muted small py-3 @(!string.IsNullOrEmpty(Model.FeaturedImageUrl) ? "d-none" : "")">
                            <i class="fa-regular fa-image fs-1 d-block mb-1"></i>
                            Xem trước ảnh bìa ở đây
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const imgInput = document.getElementById('imgUrlInput');
            const imgPreview = document.getElementById('imgPreview');
            const imgPlaceholder = document.getElementById('imgPlaceholder');

            if (imgInput) {
                imgInput.addEventListener('input', function () {
                    const url = imgInput.value.trim();
                    if (url) {
                        imgPreview.src = url;
                        imgPreview.classList.remove('d-none');
                        imgPlaceholder.classList.add('d-none');
                    } else {
                        imgPreview.classList.add('d-none');
                        imgPlaceholder.classList.remove('d-none');
                    }
                });
            }
        });
    </script>
}