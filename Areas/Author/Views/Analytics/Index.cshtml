@model BlogPlatform.ViewModel.AnalyticsViewModel

@{
    ViewData["Title"] = "Thống kê bài viết";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Thống kê bài viết</h2>
            <p class="text-muted mb-0">Tổng quan lượt xem và tương tác của các bài bạn đã đăng.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Tổng bài viết</div>
                    <div class="display-6 fw-bold">@Model.TotalPosts</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Tổng lượt xem</div>
                    <div class="display-6 fw-bold">@Model.TotalViews</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Tổng lượt thích</div>
                    <div class="display-6 fw-bold">@Model.TotalLikes</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Tổng bình luận</div>
                    <div class="display-6 fw-bold">@Model.TotalComments</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.PostRows.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Bài viết</th>
                                <th>Trạng thái</th>
                                <th>Lượt xem</th>
                                <th>Like</th>
                                <th>Bình luận</th>
                                <th>Đăng ngày</th>
                                <th>Tương tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.PostRows)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@row.Title</div>
                                        <div class="small text-muted">/post/@row.Slug</div>
                                    </td>
                                    <td>
                                        @if (row.PublishedAt.HasValue)
                                        {
                                            <span class="badge bg-success">Đã đăng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Bản nháp</span>
                                        }
                                    </td>
                                    <td>@row.ViewCount</td>
                                    <td>@row.LikeCount</td>
                                    <td>@row.CommentCount</td>
                                    <td>
                                        @(row.PublishedAt.HasValue ? row.PublishedAt.Value.ToString("dd/MM/yyyy") : "-")
                                    </td>
                                    <td>@string.Format("{0:0.00}%", row.EngagementRate)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">Bạn chưa có bài viết nào để thống kê.</div>
    }
</div>
