@model BlogPlatform.ViewModel.AnalyticsViewModel

@{
    ViewData["Title"] = "Thống kê bài viết";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Thống kê tổng quan</h2>
            <p class="text-muted mb-0">Hiệu suất và lượt tương tác bài viết của bạn</p>
        </div>
        <a asp-area="Author" asp-controller="Post" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-journal-text me-1"></i>Quản lý bài viết
        </a>
    </div>

    <!-- Summary Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-file-earmark-post fs-2"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small">Tổng số bài viết</div>
                        <div class="fs-2 fw-bold">@Model.TotalPosts</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-eye fs-2"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small">Tổng lượt xem</div>
                        <div class="fs-2 fw-bold">@Model.TotalViews</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger text-white h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-hand-thumbs-up fs-2"></i>
                    </div>
                    <div>
                        <div class="text-white-50 small">Tổng lượt thích</div>
                        <div class="fs-2 fw-bold">@Model.TotalLikes</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-black bg-opacity-10 p-3 me-3">
                        <i class="bi bi-chat-left-text fs-2"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Số bình luận</div>
                        <div class="fs-2 fw-bold">@Model.TotalComments</div>
                        @if (Model.PendingComments > 0)
                        {
                            <span class="badge bg-danger text-white mt-1">@Model.PendingComments chờ duyệt</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-list-stars me-2"></i>Chi tiết từng bài viết</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.PostRows == null || !Model.PostRows.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                    Chưa có bài viết nào để thống kê.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tiêu đề bài viết</th>
                                <th class="text-center">Ngày đăng</th>
                                <th class="text-center">Lượt xem</th>
                                <th class="text-center">Lượt thích</th>
                                <th class="text-center">Bình luận</th>
                                <th class="text-center">Tỉ lệ tương tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.PostRows)
                            {
                                <tr>
                                    <td>
                                        <a asp-area="User" asp-controller="Blog" asp-action="Detail" asp-route-slug="@row.Slug" class="fw-bold text-decoration-none text-dark">
                                            @row.Title
                                        </a>
                                    </td>
                                    <td class="text-center text-muted small">
                                        @(row.PublishedAt?.ToString("dd/MM/yyyy") ?? "Chưa đăng")
                                    </td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@row.ViewCount</span></td>
                                    <td class="text-center"><span class="badge bg-light text-danger border">@row.LikeCount</span></td>
                                    <td class="text-center"><span class="badge bg-light text-primary border">@row.CommentCount</span></td>
                                    <td class="text-center">
                                        <div class="progress" style="height: 18px; min-width: 100px;">
                                            <div class="progress-bar bg-info text-dark fw-bold small" role="progressbar" style="width: @(Math.Min(row.EngagementRate, 100))%;">
                                                @row.EngagementRate%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
