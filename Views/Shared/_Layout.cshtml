<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BlogPlatform</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* TODO (Khu B): chèn CSS variables theo BlogSetting của tác giả đang xem *@
</head>
<body>
    <header class="site-header">
        <div class="container header-row">
            <a href="/" class="brand" aria-label="Trang chủ BlogPlatform">
                <span class="brand-mark">B</span>
                <span>BlogPlatform</span>
            </a>

            <nav class="main-nav" aria-label="Điều hướng chính">
                <a href="/">Trang chủ</a>
                <a href="/">Bài viết</a>
                <a href="/">Khám phá</a>
                <a href="/">Liên hệ</a>
            </nav>

            <div class="header-actions">
                @await Html.PartialAsync("_AccountMenu")
            </div>
        </div>
    </header>

    <main class="page-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p>&copy; 2026 - BlogPlatform</p>
            <span>Viết, chia sẻ và kết nối</span>
        </div>
    </footer>

    @* jQuery dùng chung cho AJAX (Issue #9) và validation form (Issue #3) — dùng CDN *@
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
