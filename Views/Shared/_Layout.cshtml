<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BlogPlatform</title>
    <!-- Bootstrap 5.3.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (ViewBag.BlogPrimaryColor != null || ViewBag.BlogFontFamily != null)
    {
        <style>
            :root {
                @if (ViewBag.BlogPrimaryColor != null) { <text>--primary: @ViewBag.BlogPrimaryColor;</text> }
                @if (ViewBag.BlogFontFamily != null) { <text>--font: '@ViewBag.BlogFontFamily', sans-serif;</text> }
            }
        </style>
    }
</head>
<body>
    <header class="site-header">
        <div class="header-container">
            <a href="/" class="site-logo">
                <i class="fa-solid fa-layer-group"></i>
                <span>BlogPlatform</span>
            </a>

            <form action="/User/Blog/Search" method="get" class="header-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" name="Keyword" placeholder="Tìm kiếm bài viết..." autocomplete="off" />
            </form>

            @await Html.PartialAsync("_AccountMenu")
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-container">
            <p>&copy; 2026 <strong>BlogPlatform</strong> — Nền tảng chia sẻ tri thức & bài viết chất lượng cao.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

